@model HomeViewModel
@{
    ViewData["Title"] = "Portal Académico";
}

<div class="jumbotron bg-primary text-white rounded p-5 mb-4">
    <div class="container-fluid text-center">
        <h1 class="display-4">Portal Académico</h1>
        <p class="lead">Sistema de Gestión de Cursos y Matrículas</p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <p class="mb-0">¡Bienvenido, @User.Identity.Name!</p>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-light btn-lg">Iniciar Sesión</a>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-light btn-lg">Registrarse</a>
        }
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card border-primary">
            <div class="card-body text-center">
                <i class="fas fa-book fa-3x text-primary mb-3"></i>
                <h5 class="card-title">Catálogo de Cursos</h5>
                <p class="card-text">Explora nuestra oferta académica y encuentra el curso perfecto para ti.</p>
                <a asp-controller="Cursos" asp-action="Index" class="btn btn-primary">Ver Cursos</a>
            </div>
        </div>
    </div>
    
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="col-md-4">
            <div class="card border-success">
                <div class="card-body text-center">
                    <i class="fas fa-user-graduate fa-3x text-success mb-3"></i>
                    <h5 class="card-title">Mis Matrículas</h5>
                    <p class="card-text">Consulta el estado de tus inscripciones y cursos matriculados.</p>
                    <a asp-controller="Matriculas" asp-action="Index" class="btn btn-success">Ver Matrículas</a>
                </div>
            </div>
        </div>
        
        @if (User.IsInRole("Coordinador"))
        {
            <div class="col-md-4">
                <div class="card border-warning">
                    <div class="card-body text-center">
                        <i class="fas fa-cogs fa-3x text-warning mb-3"></i>
                        <h5 class="card-title">Panel de Coordinador</h5>
                        <p class="card-text">Administra cursos y gestiona las matrículas de estudiantes.</p>
                        <a href="#" class="btn btn-warning">Ir al Panel</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-md-4">
            <div class="card border-info">
                <div class="card-body text-center">
                    <i class="fas fa-info-circle fa-3x text-info mb-3"></i>
                    <h5 class="card-title">¿Nuevo Usuario?</h5>
                    <p class="card-text">Regístrate para acceder a todas las funcionalidades del portal.</p>
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-info">Crear Cuenta</a>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card border-secondary">
                <div class="card-body text-center">
                    <i class="fas fa-question-circle fa-3x text-secondary mb-3"></i>
                    <h5 class="card-title">Ayuda</h5>
                    <p class="card-text">¿Tienes dudas sobre el proceso de matrícula? Consulta nuestra guía.</p>
                    <a href="#" class="btn btn-secondary">Ver Ayuda</a>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.UltimoCursoVisitado != null)
{
    <div class="alert alert-info mt-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-bookmark me-2"></i>
                <strong>Último curso visitado:</strong> @Model.UltimoCursoVisitado.Nombre
                <small class="text-muted">(@Model.UltimoCursoVisitado.Codigo)</small>
            </div>
            <div>
                <a asp-controller="Cursos" asp-action="Detalle" asp-route-id="@Model.UltimoCursoVisitado.Id" 
                   class="btn btn-sm btn-outline-info">
                    <i class="fas fa-eye me-1"></i>Volver al curso
                </a>
            </div>
        </div>
        <div class="mt-2">
            <small class="text-muted">
                <i class="fas fa-clock me-1"></i>@Model.UltimoCursoVisitado.HorarioInicio.ToString("HH:mm") - @Model.UltimoCursoVisitado.HorarioFin.ToString("HH:mm") | 
                <i class="fas fa-credit-card me-1"></i>@Model.UltimoCursoVisitado.Creditos créditos
            </small>
        </div>
    </div>
}
