@model HomeViewModel
@{
    ViewData["Title"] = "Portal Académico";
}

<div class="jumbotron text-white rounded-4 p-5 mb-5 fade-in-up">
    <div class="container-fluid text-center">
        <div class="row align-items-center">
            <div class="col-md-8 mx-auto">
                <i class="fas fa-graduation-cap fa-4x mb-4 opacity-75"></i>
                <h1 class="display-3 fw-bold mb-3">Portal Académico</h1>
                <p class="lead fs-4 mb-4">Sistema Integral de Gestión de Cursos y Matrículas</p>
                <p class="fs-6 mb-4 opacity-90">Plataforma moderna para la administración académica</p>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="alert alert-light d-inline-block">
                        <i class="fas fa-user-circle me-2"></i>
                        <strong>¡Bienvenido de vuelta, @User.Identity.Name!</strong>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-3 justify-content-center flex-wrap">
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-light btn-lg px-4 py-3">
                            <i class="fas fa-sign-in-alt me-2"></i>Iniciar Sesión
                        </a>
                        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-light btn-lg px-4 py-3">
                            <i class="fas fa-user-plus me-2"></i>Registrarse
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4 col-md-6">
        <div class="card h-100 shadow-custom border-0 fade-in-up">
            <div class="card-body text-center p-4">
                <div class="feature-icon bg-primary bg-gradient rounded-circle p-3 mb-4 mx-auto" style="width: 80px; height: 80px;">
                    <i class="fas fa-book fa-2x text-white"></i>
                </div>
                <h5 class="card-title fw-bold mb-3">Catálogo de Cursos</h5>
                <p class="card-text text-muted">Explora nuestra oferta académica completa con filtros avanzados y encuentra el curso perfecto para tu desarrollo profesional.</p>
                <a asp-controller="Cursos" asp-action="Index" class="btn btn-primary btn-lg">
                    <i class="fas fa-search me-2"></i>Explorar Cursos
                </a>
            </div>
        </div>
    </div>
    
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="col-lg-4 col-md-6">
            <div class="card h-100 shadow-custom border-0 fade-in-up">
                <div class="card-body text-center p-4">
                    <div class="feature-icon bg-success bg-gradient rounded-circle p-3 mb-4 mx-auto" style="width: 80px; height: 80px;">
                        <i class="fas fa-user-graduate fa-2x text-white"></i>
                    </div>
                    <h5 class="card-title fw-bold mb-3">Mis Matrículas</h5>
                    <p class="card-text text-muted">Consulta el estado de tus inscripciones, revisa tus cursos matriculados y mantente al día con tu progreso académico.</p>
                    <a asp-controller="Matriculas" asp-action="Index" class="btn btn-success btn-lg">
                        <i class="fas fa-graduation-cap me-2"></i>Ver Matrículas
                    </a>
                </div>
            </div>
        </div>
        
        @if (User.IsInRole("Coordinador"))
        {
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 shadow-custom border-0 fade-in-up">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-warning bg-gradient rounded-circle p-3 mb-4 mx-auto" style="width: 80px; height: 80px;">
                            <i class="fas fa-cogs fa-2x text-white"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-3">Panel de Coordinador</h5>
                        <p class="card-text text-muted">Administra cursos, gestiona matrículas de estudiantes y controla todos los aspectos del sistema académico.</p>
                        <a asp-controller="Coordinador" asp-action="Index" class="btn btn-warning btn-lg">
                            <i class="fas fa-tachometer-alt me-2"></i>Ir al Panel
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-md-4">
            <div class="card border-info">
                <div class="card-body text-center">
                    <i class="fas fa-info-circle fa-3x text-info mb-3"></i>
                    <h5 class="card-title">¿Nuevo Usuario?</h5>
                    <p class="card-text">Regístrate para acceder a todas las funcionalidades del portal.</p>
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-info">Crear Cuenta</a>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card border-secondary">
                <div class="card-body text-center">
                    <i class="fas fa-question-circle fa-3x text-secondary mb-3"></i>
                    <h5 class="card-title">Ayuda</h5>
                    <p class="card-text">¿Tienes dudas sobre el proceso de matrícula? Consulta nuestra guía.</p>
                    <a href="#" class="btn btn-secondary">Ver Ayuda</a>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.UltimoCursoVisitado != null)
{
    <div class="alert alert-info mt-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-bookmark me-2"></i>
                <strong>Último curso visitado:</strong> @Model.UltimoCursoVisitado.Nombre
                <small class="text-muted">(@Model.UltimoCursoVisitado.Codigo)</small>
            </div>
            <div>
                <a asp-controller="Cursos" asp-action="Detalle" asp-route-id="@Model.UltimoCursoVisitado.Id" 
                   class="btn btn-sm btn-outline-info">
                    <i class="fas fa-eye me-1"></i>Volver al curso
                </a>
            </div>
        </div>
        <div class="mt-2">
            <small class="text-muted">
                <i class="fas fa-clock me-1"></i>@Model.UltimoCursoVisitado.HorarioInicio.ToString("HH:mm") - @Model.UltimoCursoVisitado.HorarioFin.ToString("HH:mm") | 
                <i class="fas fa-credit-card me-1"></i>@Model.UltimoCursoVisitado.Creditos créditos
            </small>
        </div>
    </div>
}
