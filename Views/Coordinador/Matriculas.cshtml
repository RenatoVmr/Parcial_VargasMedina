@model List<Matricula>
@{
    ViewData["Title"] = "Gestión de Matrículas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-user-graduate me-2"></i>Gestión de Matrículas</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Volver al Panel
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filtros y estadísticas -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card border-info">
            <div class="card-body text-center">
                <i class="fas fa-list fa-2x text-info mb-2"></i>
                <h4 class="text-info">@Model.Count</h4>
                <small>Total Matrículas</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-success">
            <div class="card-body text-center">
                <i class="fas fa-check fa-2x text-success mb-2"></i>
                <h4 class="text-success">@Model.Count(m => m.Estado == EstadoMatricula.Confirmada)</h4>
                <small>Confirmadas</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-warning">
            <div class="card-body text-center">
                <i class="fas fa-clock fa-2x text-warning mb-2"></i>
                <h4 class="text-warning">@Model.Count(m => m.Estado == EstadoMatricula.Pendiente)</h4>
                <small>Pendientes</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-danger">
            <div class="card-body text-center">
                <i class="fas fa-times fa-2x text-danger mb-2"></i>
                <h4 class="text-danger">@Model.Count(m => m.Estado == EstadoMatricula.Cancelada)</h4>
                <small>Canceladas</small>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Estudiante</th>
                        <th>Curso</th>
                        <th>Fecha Registro</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var matricula in Model)
                    {
                        <tr>
                            <td>
                                <div>
                                    <strong>@matricula.Usuario.Email</strong>
                                    <br>
                                    <small class="text-muted">ID: @matricula.UsuarioId</small>
                                </div>
                            </td>
                            <td>
                                <div>
                                    <strong>@matricula.Curso.Nombre</strong>
                                    <br>
                                    <small class="text-muted">@matricula.Curso.Codigo</small>
                                </div>
                            </td>
                            <td>
                                <span>@matricula.FechaRegistro.ToString("dd/MM/yyyy")</span>
                                <br>
                                <small class="text-muted">@matricula.FechaRegistro.ToString("HH:mm")</small>
                            </td>
                            <td>
                                @switch (matricula.Estado)
                                {
                                    case EstadoMatricula.Confirmada:
                                        <span class="badge bg-success">Confirmada</span>
                                        break;
                                    case EstadoMatricula.Pendiente:
                                        <span class="badge bg-warning">Pendiente</span>
                                        break;
                                    case EstadoMatricula.Cancelada:
                                        <span class="badge bg-danger">Cancelada</span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (matricula.Estado == EstadoMatricula.Pendiente)
                                {
                                    <div class="btn-group" role="group">
                                        <form asp-action="CambiarEstadoMatricula" method="post" style="display: inline;">
                                            <input type="hidden" name="id" value="@matricula.Id" />
                                            <input type="hidden" name="nuevoEstado" value="@((int)EstadoMatricula.Confirmada)" />
                                            <button type="submit" class="btn btn-sm btn-success" title="Confirmar">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        </form>
                                        <form asp-action="CambiarEstadoMatricula" method="post" style="display: inline;">
                                            <input type="hidden" name="id" value="@matricula.Id" />
                                            <input type="hidden" name="nuevoEstado" value="@((int)EstadoMatricula.Cancelada)" />
                                            <button type="submit" class="btn btn-sm btn-danger" title="Cancelar">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                                else if (matricula.Estado == EstadoMatricula.Confirmada)
                                {
                                    <form asp-action="CambiarEstadoMatricula" method="post" style="display: inline;">
                                        <input type="hidden" name="id" value="@matricula.Id" />
                                        <input type="hidden" name="nuevoEstado" value="@((int)EstadoMatricula.Cancelada)" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancelar Matrícula">
                                            <i class="fas fa-ban"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        <i class="fas fa-lock"></i> Sin acciones
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        @if (!Model.Any())
        {
            <div class="text-center py-4">
                <i class="fas fa-user-graduate fa-3x text-muted mb-3"></i>
                <p class="text-muted">No hay matrículas registradas.</p>
            </div>
        }
    </div>
</div>