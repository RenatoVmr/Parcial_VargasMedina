@model List<Curso>
@{
    ViewData["Title"] = "Gestión de Cursos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-book me-2"></i>Gestión de Cursos</h2>
    <div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Volver al Panel
        </a>
        <a asp-action="CrearCurso" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Crear Nuevo Curso
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Créditos</th>
                        <th>Cupo</th>
                        <th>Horario</th>
                        <th>Matriculados</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var curso in Model)
                    {
                        var matriculados = curso.Matriculas?.Count(m => m.Estado == EstadoMatricula.Confirmada) ?? 0;
                        <tr>
                            <td>
                                <strong>@curso.Codigo</strong>
                            </td>
                            <td>@curso.Nombre</td>
                            <td>
                                <span class="badge bg-info">@curso.Creditos</span>
                            </td>
                            <td>@curso.CupoMaximo</td>
                            <td>
                                <small class="text-muted">
                                    @curso.HorarioInicio.ToString("HH:mm") - @curso.HorarioFin.ToString("HH:mm")
                                </small>
                            </td>
                            <td>
                                <span class="badge @(matriculados >= curso.CupoMaximo ? "bg-danger" : "bg-success")">
                                    @matriculados/@curso.CupoMaximo
                                </span>
                            </td>
                            <td>
                                @if (curso.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="EditarCurso" asp-route-id="@curso.Id" 
                                       class="btn btn-sm btn-outline-primary" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-controller="Cursos" asp-action="Detalle" asp-route-id="@curso.Id" 
                                       class="btn btn-sm btn-outline-info" title="Ver Detalle">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="EliminarCurso" asp-route-id="@curso.Id" 
                                       class="btn btn-sm btn-outline-danger" title="Eliminar">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        @if (!Model.Any())
        {
            <div class="text-center py-4">
                <i class="fas fa-book fa-3x text-muted mb-3"></i>
                <p class="text-muted">No hay cursos registrados.</p>
                <a asp-action="CrearCurso" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Crear Primer Curso
                </a>
            </div>
        }
    </div>
</div>